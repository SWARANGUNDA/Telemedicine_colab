# =============================================================================
# TeleMed AI Platform — Production Environment Configuration Template
# =============================================================================

# Server Security
ENVIRONMENT=production
PORT=8000
SECRET_KEY=generate-strong-random-64-character-hex-string-here
JWT_SECRET_KEY=generate-strong-random-64-character-hex-string-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Sole Database Architecture (PostgreSQL 17)
DATABASE_URL=postgresql://postgres:StrongProductionPassword123!@postgres:5432/telemed_db
POSTGRES_DB=telemed_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=StrongProductionPassword123!

# Cache & Celery Task Queue (Redis 7)
REDIS_URL=redis://redis:6379/0

# MinIO / AWS S3 Object Storage
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=telemed_minio_admin
S3_SECRET_KEY=telemed_minio_secret_password_123!
S3_BUCKET_NAME=telemed-health-reports
S3_REGION=us-east-1

# SMTP Transactional Email
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-production-sendgrid-api-key
SENDER_EMAIL=noreply@telemed.ai

# CORS & Security
CORS_ORIGINS=["https://telemed.ai", "https://app.telemed.ai"]
